<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/css/login.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Quantico:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    rel="stylesheet">

</head>

<body class="background">


  <div class="ImgBox">
    <img src="assets/Überschriften/DUELIST.png" alt="Login text">

    <img class="LogInImg2" src="assets/Überschriften/register.png" alt="register text">
  </div>

  <form action="/register" method="POST" class="login">
    <input type="text" name="username" placeholder="Benutzername" class="text">
    <input type="password" name="password" placeholder="Password" class="text">

    <div>
      <input type="submit" name="send" value="Registrieren" class="submit" class="button2">
      <a href="/login">BACK</a>
    </div>
  </form>

</body>

</html>